# Copy to your local environment; do not commit actual .env files.
# PowerShell example:   $env:ADMIN_PASSWORD = "something-long"
# Git Bash example:     export ADMIN_PASSWORD=something-long

# Dashboard logins. If a password is empty, the backend generates a random one
# at startup and prints it in the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-local-password
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=replace-with-another-password

# Only needed when NOT using the "embedded" profile (i.e. your own PostgreSQL).
DB_URL=jdbc:postgresql://localhost:5432/hokiebikerack
DB_USERNAME=hokiebikerack
DB_PASSWORD=replace-with-local-development-password

SERVER_PORT=8080
# How long racks may work offline with their saved card list.
HBR_SNAPSHOT_VALIDITY=72h
